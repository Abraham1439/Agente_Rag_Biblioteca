# --- LLM: OpenRouter (API key entregada por el docente al grupo) ---
OPENROUTER_API_KEY="pega_aqui_la_key_del_grupo"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="openai/gpt-6-luna"
LLM_REASONING_EFFORT="low"
LLM_TIMEOUT=60

# --- Embeddings: mistral-embed a través de OpenRouter (Mistral ya no ofrece API gratuita) ---
EMBEDDING_API_KEY="pega_aqui_la_key_del_grupo"
EMBEDDING_BASE_URL="https://openrouter.ai/api/v1"
EMBEDDING_MODEL="mistralai/mistral-embed-2312"

# --- RAG ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=80
TOP_K=4
SCORE_THRESHOLD=0.45

# --- Memoria y agente ---
MEMORY_WINDOW_K=10
AGENT_MAX_ITERATIONS=8
# STORAGE_DIR="storage"

# --- EP3: versión del agente ---
# v1 = agente del EP2 sin cambios (línea base) · v2 = rediseño con guardrails y optimizaciones
AGENT_VERSION="v2"
MAX_INPUT_CHARS=1000

# --- EP3: costos (US$ por millón de tokens; verificar en https://openrouter.ai/models) ---
PRECIO_ENTRADA_USD_MTOK=0.10
PRECIO_SALIDA_USD_MTOK=0.50

# --- EP3: juez LLM (DEBE ser un modelo distinto al del agente para evitar la autopreferencia) ---
# Verificar el ID exacto y el precio en https://openrouter.ai/models antes de correr la evaluación.
JUDGE_MODEL="openai/gpt-6-sol"
JUDGE_REASONING_EFFORT="low"
PRECIO_ENTRADA_JUEZ_USD_MTOK=2.0
PRECIO_SALIDA_JUEZ_USD_MTOK=10.0

# --- EP3: LangSmith (opcional). Si se completan, cada turno queda además como traza en LangSmith ---
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="lsv2_..."
# LANGSMITH_PROJECT="agente-biblioteca-ep3"

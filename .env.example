# --- LLM: OpenRouter (API key entregada por el docente al grupo) ---
OPENROUTER_API_KEY="pega_aqui_la_key_del_grupo"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="openai/gpt-6-luna"
LLM_REASONING_EFFORT="low"
LLM_TIMEOUT=60

# --- Embeddings: Mistral (igual que en el EP1) ---
EMBEDDING_API_KEY="tu_clave_mistral"
EMBEDDING_BASE_URL="https://api.mistral.ai/v1"
EMBEDDING_MODEL="mistral-embed"

# --- RAG ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=80
TOP_K=4
SCORE_THRESHOLD=0.45

# --- Memoria y agente ---
MEMORY_WINDOW_K=10
AGENT_MAX_ITERATIONS=8
# STORAGE_DIR="storage"
